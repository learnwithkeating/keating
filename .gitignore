# Credentials — never commit. The app reads its environment from here at startup.
.env

# Brainstorming-related
brainstorming/

# Raw axe-core output from the accessibility suite, rewritten on every run.
.a11y-report/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Per-installation state, not platform code: an installation's model choices and layout
# defaults, which startup moves into the workspace's .keating/settings.json, keeping the file
# it migrated from under .migrated. Defaults live in main.py (DEFAULT_SETTINGS).
settings.json
settings.json.migrated

# macOS
.DS_Store

# Instance state, if a workspace is ever pointed at the checkout. Holds argon2 password
# hashes, the session signing key, and live sessions: never committable, in any repository,
# public or not.
.keating/
